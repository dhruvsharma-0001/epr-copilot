# EPR Compliance Copilot - Environment Configuration
# Copy this file to .env and insert your API key(s) to activate LIVE mode.

# 1. Google Gemini (Recommended)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# 2. Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 3. OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional LangSmith Tracing for RAG evaluation
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=epr-copilot
